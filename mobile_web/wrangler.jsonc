{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compya-mobile-control",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "durable_objects": {"bindings": [{"name": "CONTROL", "class_name": "ControlRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ControlRoom"]}],
  "rules": [{"type": "Text", "globs": ["**/*.html", "**/*.css", "**/*.js.txt", "**/*.webmanifest"], "fallthrough": true}, {"type": "Data", "globs": ["**/*.png"], "fallthrough": true}]
}
